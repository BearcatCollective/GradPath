<mxfile host="app.diagrams.net"><diagram id="d2flow" name="D2 Figure 2 - Flow"><mxGraphModel dx="1200" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="GradPath" style="text;html=0;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="58" y="40" width="300" height="34" as="geometry"/></mxCell><mxCell id="goal" value="A scheduler for UC students that uses a degree audit and UC's course catalog to automatically create the fastest possible graduation plan. It considers course prerequisites and semester availability, while allowing students to add, remove, or edit classes and see plans for additional majors or minors." style="text;html=0;whiteSpace=wrap;fontSize=13;fontStyle=1;fontFamily=Times New Roman;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="58" y="74" width="1100" height="52" as="geometry"/></mxCell><mxCell id="n1" value="Student uploads degree audit" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="146.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="d1" value="Is it a UC degree audit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="163.0" y="239.0" width="290" height="76" as="geometry"/></mxCell><mxCell id="e1" value="Reject file and show where&#xa;to download the audit" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="564.0" y="251.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n2" value="Read audit in browser,&#xa;student confirms summary" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="370.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n3" value="Student picks max credits, summer,&#xa;target term, and co-ops left to plan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="463.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n4" value="Get course data from API" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="555.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="d2" value="API working?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="194.0" y="662.0" width="228" height="76" as="geometry"/></mxCell><mxCell id="e2" value="Show error and&#xa;a Retry button" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="534.0" y="674.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n5" value="Place co-op semesters&#xa;using the co-op rules" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="792.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="d3" value="Completed + planned co-ops&#xa;meet minimum and fit rules?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="111.0" y="886.0" width="394" height="76" as="geometry"/></mxCell><mxCell id="e3" value="Explain the conflict,&#xa;student changes settings" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="617.0" y="898.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n6" value="Algorithm 1 builds the plan" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="1016.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="d4" value="All courses placed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="185.0" y="1109.0" width="246" height="76" as="geometry"/></mxCell><mxCell id="e4" value="Flag the course" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="543.0" y="1121.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n7" value="Show plan, student can edit" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="1239.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n8" value="Check edits: prerequisites,&#xa;terms, credits, requirements" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="1332.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="d5" value="Any conflicts?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="194.0" y="1426.0" width="228" height="76" as="geometry"/></mxCell><mxCell id="e5" value="Show the conflicts" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;html=0;" vertex="1" parent="1"><mxGeometry x="534.0" y="1438.0" width="284" height="52" as="geometry"/></mxCell><mxCell id="n9" value="Make share link (audit data, settings,&#xa;edits, warnings, date, v